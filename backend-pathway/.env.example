# ---- Local LLM (optional, free): https://ollama.com ----
#   ollama pull llama3.2:3b && ollama serve
# Any OpenAI-compatible server works (llama.cpp server, vLLM, LM Studio, LocalAI).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
# LLM_API_KEY=            # only if your server requires one
# LLM_ENABLED=false       # force deterministic explanations

# ---- Realtime hub (frontend connects here) ----
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8765

# ---- Real telemetry ingest (POST /telemetry, POST /trucks) ----
ENABLE_HTTP_INGEST=true
INGEST_HOST=0.0.0.0
INGEST_PORT=8090

# ---- Telematics feed ----
# traccar  = positions forwarded by a Traccar server (infra/traccar.sh up) from GPS trackers
#            (simulated trackers: devices/fleet_devices.py). start-demo.sh picks this when Docker is available.
# internal = built-in simulator (no Docker needed)
FEED=internal
INTEGRATIONS_PORT=8091
# Where approved decisions are sent (carrier / order system). The simulated fleet listens here:
# DECISION_WEBHOOK_URL=http://127.0.0.1:9099/decisions

# ---- Built-in simulator (FEED=internal) ----
FLEET_SIZE=3                       # try 1000+ for load tests
SIM_SPEEDUP=1                      # simulated seconds per real second
SCENARIO=data/scenarios/demo.json  # or "none"
RANDOM_INCIDENT_RATE=0             # incidents per truck per simulated hour

# ---- Scaling ----
# PATHWAY_THREADS=4

# ---- Decision thresholds (see core/config.py) ----
# FF_MIN_SAVINGS_ABS=2000   # INR
# FF_MIN_SAVINGS_RATIO=0.05
# FF_MIN_CONFIDENCE=0.6
# FF_CO2_KG_PER_KM=0.9

# ---- Tracker health ----
# Seconds without data before a truck is flagged SIGNAL LOST (demo value; ~300 in production)
SIGNAL_LOST_SECONDS=90

# ---- Demo ----
# Show "Trigger breakdown" / "Reset demo" buttons on the dashboard (turn off for real deployments)
DEMO_CONTROLS=true

# ---- Security ----
# Browser origins allowed to open the realtime WebSocket (comma-separated). Add your deployed dashboard URL.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
