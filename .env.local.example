# NextAuth.js Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

# WebSocket backend URL (backend-pathway/websocket_server.py)
NEXT_PUBLIC_WS_URL=ws://localhost:8765

# Demo login (demo@fleetfusion.com / demo123) is always on in dev.
# For a production build (e.g. hosted hackathon demo), opt in explicitly:
# ENABLE_DEMO_LOGIN=true
